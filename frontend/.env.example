NEXT_PUBLIC_API_URL=http://localhost:5000

# Meta WhatsApp Embedded Signup — not secret (used client-side by the
# Facebook JS SDK), but must match backend/.env's META_APP_ID and
# META_EMBEDDED_SIGNUP_CONFIG_ID exactly.
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_CONFIG_ID=

# A SEPARATE Login Configuration, created in the same Meta App Dashboard
# under Facebook Login for Business → Configurations, carrying the Lead
# Ads permissions (pages_show_list, leads_retrieval, pages_manage_ads,
# pages_read_engagement) instead of WhatsApp's onboarding ones. Powers the
# "Connect Facebook Page for Lead Ads" button (FacebookLeadAdsConnect.js).
NEXT_PUBLIC_META_LEADS_CONFIG_ID=

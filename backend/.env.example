DATABASE_URL=postgresql://username:password@ep-xxxx.neon.tech/neondb?sslmode=require
JWT_SECRET=your_super_secret_jwt_key_change_this
PORT=5000

# Public URL where THIS backend is reachable from the internet (no trailing slash).
# Required in production so webhook URLs (Google Ads / WhatsApp) are generated
# with the real domain instead of localhost. Leave unset in local dev.
# Example: PUBLIC_API_URL=https://api.zalgocrm.com
PUBLIC_API_URL=
